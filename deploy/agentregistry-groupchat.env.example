# Group chat data plane. Source this file in the agent-registry unit, or
# export the same variables before starting the process.
#
# The module is off unless A2X_GROUPCHAT_ENABLED=true; when off, every
# /api/groups route returns a structured 404.

A2X_GROUPCHAT_ENABLED=false

# "postgres" (production) or "memory" (single-process, non-durable — useful
# for a smoke test, never for a deployment).
A2X_GROUPCHAT_BACKEND=postgres

# Required when the module is enabled with the postgres backend. The driver is
# optional: install with `pip install 'psycopg[binary,pool]'`.
A2X_GROUPCHAT_DSN=postgresql://registry:replace-me@127.0.0.1:5432/registry

# Schema holding the gc_* tables. Created on first start if absent.
A2X_GROUPCHAT_SCHEMA=public

# Per-message payload ceiling, in bytes, measured on the serialized JSON.
A2X_GROUPCHAT_MAX_MESSAGE_BYTES=65536

# How many groups one principal may own. Bounds the connection table: an
# aggregating Agent subscribed to thousands of groups is the one shape that
# makes the in-process subscription registry expensive.
A2X_GROUPCHAT_MAX_GROUPS_PER_PRINCIPAL=200

# Group size ceiling. Also caps fan-out per message.
A2X_GROUPCHAT_MAX_MEMBERS_PER_GROUP=500

# Pull-window bounds. max_page_size is the hard ceiling a caller cannot
# exceed via ?limit=; default_page_size is used when ?limit= is omitted.
A2X_GROUPCHAT_MAX_PAGE_SIZE=100
A2X_GROUPCHAT_DEFAULT_PAGE_SIZE=50

# Per-group send rate limit. One busy Agent loop can otherwise saturate the
# group's seq_counter row lock and stall every other sender.
A2X_GROUPCHAT_RATE_LIMIT_PER_GROUP=600
A2X_GROUPCHAT_RATE_LIMIT_WINDOW_SECONDS=60
