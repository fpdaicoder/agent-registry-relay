# Root-only deployment environment. Replace the token before installation.
A2X_STREAM_PROXY_CREATE_TOKEN=replace-with-at-least-32-random-characters
A2X_STREAM_PROXY_HOST=0.0.0.0
A2X_STREAM_PROXY_PORT=18002
A2X_STREAM_PROXY_PUBLIC_WS_BASE_URL=wss://stream.registry.example.com
A2X_STREAM_PROXY_MAX_OBJECT_BYTES=268435456
A2X_STREAM_PROXY_MAX_CHUNK_BYTES=1048576
A2X_STREAM_PROXY_MAX_SESSIONS=128
A2X_STREAM_PROXY_SESSION_TTL_SECONDS=900
A2X_STREAM_PROXY_CLEANUP_INTERVAL_SECONDS=15
A2X_STREAM_PROXY_AUTH_TIMEOUT_SECONDS=10
A2X_STREAM_PROXY_RECONNECT_GRACE_SECONDS=120
